{
  "expo": {
    "name": "Ticketly",
    "slug": "ticketly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ticketly",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.ticketly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera brukes til å scanne billetter i dør-/staff-modus.",
        "NSFaceIDUsageDescription": "Brukes for sikker innlogging der det er aktivert.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "associatedDomains": ["applinks:ticketly.no", "applinks:www.ticketly.no"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "no.ticketly.app",
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "ticketly.no", "pathPrefix": "/events" },
            { "scheme": "https", "host": "ticketly.no", "pathPrefix": "/t" },
            { "scheme": "https", "host": "ticketly.no", "pathPrefix": "/orders" },
            { "scheme": "ticketly" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera brukes til QR-scanning i staff-modus."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f59e0b"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      },
      "apiUrl": "http://localhost:3456"
    }
  }
}
