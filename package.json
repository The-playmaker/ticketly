{
  "name": "ticketly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ticketly/web",
    "dev:web": "npm run dev -w @ticketly/web",
    "dev:api": "npm run dev -w @ticketly/api",
    "dev:mobile": "npm run start -w @ticketly/mobile",
    "build": "npm run build -w @ticketly/database && npm run build -w @ticketly/web",
    "db:generate": "npm run generate -w @ticketly/database",
    "db:migrate": "npm run migrate -w @ticketly/database",
    "db:seed": "npm run seed -w @ticketly/database",
    "db:reset": "npm run reset -w @ticketly/database",
    "admin:create": "tsx --env-file-if-exists=.env scripts/admin-create.ts",
    "demo:cleanup": "tsx --env-file-if-exists=.env scripts/demo-cleanup.ts",
    "fulfillment:report": "tsx --env-file-if-exists=.env scripts/report-ticket-fulfillment-mismatches.ts",
    "test": "npm run test -w @ticketly/web && npm run test -w @ticketly/ticketing --if-present",
    "test:e2e": "npm run test:e2e -w @ticketly/web",
    "typecheck": "npm run typecheck -w @ticketly/web && npm run typecheck -w @ticketly/ticketing && npm run typecheck -w @ticketly/mobile --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "dotenv": "^18.0.5",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2"
}
