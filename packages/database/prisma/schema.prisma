generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum GlobalRole {
  SUPER_ADMIN
  CUSTOMER
}

enum OrgRole {
  ORGANIZER_ADMIN
  EVENT_MANAGER
  DOOR_STAFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  PAUSED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum AvailabilityDisplayMode {
  SHOW_EXACT
  SHOW_LOW_STOCK_ONLY
  HIDE
}

enum SoldOutDisplayMode {
  SOLD_OUT
  MORE_COMING
  PAUSED
}

enum AnalyticsEventType {
  PAGE_VIEW
  TICKET_SELECTION
  CHECKOUT_STARTED
  PAYMENT_INITIATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  RESERVATION_EXPIRED
}

enum Visibility {
  PUBLIC
  UNLISTED
  HIDDEN
}

enum ServiceFeeMode {
  ON_TOP // customer pays fee on top of ticket price
  INCLUDED // fee is included in ticket price
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  REVIEW_REQUIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
  REFUNDED
  TRANSFERRED
  RESERVED
}

/// Door QR presentation mode. Production default remains STATIC_QR until DYNAMIC_QR lifecycle is complete.
enum TicketQrMode {
  STATIC_QR
  DYNAMIC_QR
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CheckInResult {
  SUCCESS
  ALREADY_USED
  INVALID
  WRONG_EVENT
  CANCELLED
  REFUNDED
  EVENT_CANCELLED
}

enum PaymentProviderType {
  NEXI
  STRIPE
  VIPPS
  NETS
  ADYEN
  KLARNA
  MOCK
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum PartyRole {
  PLATFORM
  ORGANIZER
  SELLER_OF_RECORD
  PAYMENT_PROVIDER
  CUSTOMER
}

enum VatRegistrationStatus {
  REGISTERED
  NOT_REGISTERED
  EXEMPT
  UNKNOWN
}

enum RefundPolicyType {
  STATUTORY_CANCELLATION_RIGHT
  ORGANIZER_REFUND_POLICY
  EVENT_CANCELLED_REFUND
  MANUAL_REFUND
  NO_REFUND
}

enum ConsentPurpose {
  MARKETING_EMAIL
  MARKETING_SMS
  MARKETING_PUSH
  ANALYTICS
  PERSONALIZATION
  THIRD_PARTY_SHARING
}

enum ProcessingPurpose {
  CONTRACT_FULFILLMENT
  LEGAL_OBLIGATION_ACCOUNTING
  CUSTOMER_SERVICE
  EVENT_COMMUNICATION
  ANALYTICS
  MARKETING
  SECURITY
  CHECK_IN
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

enum NotificationCategory {
  TRANSACTIONAL
  SERVICE
  MARKETING
}

enum OfflineSyncStatus {
  PENDING
  SYNCED
  CONFLICT
  REJECTED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ─── Auth (NextAuth) ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  firstName     String?
  lastName      String?
  phone         String?
  image         String?
  passwordHash  String?
  globalRole    GlobalRole @default(CUSTOMER)
  isActive      Boolean   @default(true)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         OrganizationMember[]
  orders              Order[]
  checkIns            CheckIn[]
  auditLogs           AuditLog[]
  guestListCreated    GuestListEntry[]     @relation("GuestListCreatedBy")
  ticketTransfersFrom TicketTransfer[]     @relation("TransferFrom")
  ticketTransfersTo   TicketTransfer[]     @relation("TransferTo")
  eventAssignments    EventAssignment[]
  systemLogs          SystemLog[]
  consentRecords      ConsentRecord[]
  pushTokens          PushToken[]
  notificationPrefs   NotificationPreference[]
  dataRequests        DataSubjectRequest[]
  scannerSessions     ScannerSession[]
  offlineCheckIns     OfflineCheckIn[]     @relation("OfflineCheckInStaff")

  @@index([email])
  @@index([globalRole])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Password set / reset tokens (invite accept + forgot password). Store hash only.
model AuthActionToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  purpose   String // PASSWORD_RESET | INVITE_PASSWORD_SETUP
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// ─── Multi-tenant ────────────────────────────────────────────────────────────

model Organization {
  id                    String               @id @default(cuid())
  name                  String
  slug                  String               @unique
  description           String?
  logoUrl               String?
  website               String?
  isActive              Boolean              @default(true)
  allowRefunds          Boolean              @default(true)
  defaultServiceFee     Int                  @default(2000) // øre — reporting/fee config, not a wallet balance
  defaultServiceFeeMode ServiceFeeMode       @default(ON_TOP)
  defaultCurrency       String               @default("NOK")
  // Legal / seller-of-record fields (Norwegian/EEA)
  legalName             String?
  organizationNumber    String? // org.nr
  legalAddress          String?
  legalPostalCode       String?
  legalCity             String?
  legalCountry          String               @default("NO")
  contactEmail          String?
  customerServiceEmail  String?
  customerServicePhone  String?
  vatRegistrationStatus VatRegistrationStatus @default(UNKNOWN)
  termsVersion          String               @default("1.0")
  refundPolicyType      RefundPolicyType     @default(ORGANIZER_REFUND_POLICY)
  refundPolicyText      String?              @db.Text
  // Settlement config (reporting only — funds stay with licensed PSP)
  settlementConfig      Json?
  stripeConnectedAccountId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  members            OrganizationMember[]
  venues             Venue[]
  events             Event[]             @relation("EventOrganizer")
  sellerEvents       Event[]             @relation("EventSeller")
  eventSeries        EventSeries[]
  orders             Order[]
  promoCodes         PromoCode[]
  auditLogs          AuditLog[]
  invitations        OrganizationInvitation[]
  devices            Device[]
  taxTreatments      TaxTreatment[]
  retentionPolicies  RetentionPolicy[]
  offlineBundles     OfflineValidationBundle[]
  paymentConfigs     OrganizationPaymentConfiguration[]

  @@index([slug])
  @@index([isActive])
  @@index([organizationNumber])
}

/// Per-organization payment account reference for future multi-merchant Nexi setups.
/// NEVER store private/secret API keys as plaintext here — use secretRef to an env/vault alias.
model OrganizationPaymentConfiguration {
  id                 String              @id @default(cuid())
  organizationId     String
  provider           PaymentProviderType
  /// Vault/env alias only (e.g. "env:NEXI_SECRET_API_KEY") — not the secret itself
  secretRef          String?
  /// Checkout key is client-safe (Nexi "checkout key")
  checkoutKeyPublic  String?
  merchantId         String?
  environment        String? // test | production
  isActive           Boolean             @default(true)
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, isActive])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  canRefund      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  /// SHA-256 hash of the one-time invite token (never store raw token)
  tokenHash      String           @unique
  invitedById    String?
  status         InvitationStatus @default(PENDING)
  /// Optional event IDs this invite grants access to (door staff / event managers)
  restrictedEventIds String[]     @default([])
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status, expiresAt])
}

model EventAssignment {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      OrgRole  @default(EVENT_MANAGER)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// ─── Venue & Event ───────────────────────────────────────────────────────────

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  postalCode     String?
  city           String?
  country        String   @default("NO")
  capacity       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
}

model Event {
  id                   String          @id @default(cuid())
  organizationId       String // organizer (may differ from seller)
  sellerOrganizationId String // juridisk selger / seller of record
  venueId              String?
  name                 String
  slug                 String
  description          String?         @db.Text
  shortDescription     String?
  address              String?
  postalCode           String?
  city                 String?
  country              String          @default("NO")
  timezone             String          @default("Europe/Oslo")
  startsAt             DateTime
  endsAt               DateTime
  doorsOpenAt          DateTime?
  ageLimit             Int?
  coverImageUrl        String?
  capacity             Int
  status               EventStatus     @default(DRAFT)
  visibility           Visibility      @default(PUBLIC)
  category             String?
  salesStartAt         DateTime?
  salesEndAt           DateTime?
  publishAt            DateTime?
  /// Emergency / manual pause — blocks NEW reservations only
  salesPausedAt        DateTime?
  availabilityDisplay  AvailabilityDisplayMode @default(SHOW_LOW_STOCK_ONLY)
  lowStockThreshold    Int             @default(10)
  soldOutDisplay       SoldOutDisplayMode @default(SOLD_OUT)
  allowTransfer        Boolean         @default(false)
  /// QR credential mode — STATIC_QR is production default; DYNAMIC_QR requires ENABLE_DYNAMIC_QR=true
  qrMode               TicketQrMode    @default(STATIC_QR)
  /// Short-lived dynamic QR TTL in seconds (clamped 15–120 at runtime)
  dynamicQrTtlSeconds  Int             @default(30)
  serviceFee           Int?
  serviceFeeMode       ServiceFeeMode?
  currency             String          @default("NOK")
  refundPolicyType     RefundPolicyType?
  refundPolicyText     String?         @db.Text
  termsVersion         String?
  /// Waitlist when ticket type / release is sold out
  waitlistEnabled      Boolean         @default(false)
  /// If true, waitlist also when current release is sold out (unreleased remains)
  waitlistOnReleaseSoldOut Boolean     @default(false)
  /// Transactional event reminders (not marketing)
  reminder24hEnabled   Boolean         @default(true)
  reminder3hEnabled    Boolean         @default(false)
  seriesId             String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization       Organization              @relation("EventOrganizer", fields: [organizationId], references: [id], onDelete: Cascade)
  sellerOrganization Organization              @relation("EventSeller", fields: [sellerOrganizationId], references: [id], onDelete: Restrict)
  venue              Venue?                    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  series             EventSeries?              @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  images             EventImage[]
  ticketTypes        TicketType[]
  orders             Order[]
  reservations       TicketReservation[]
  checkIns           CheckIn[]
  guestList          GuestListEntry[]
  promoCodes         PromoCode[]
  assignments        EventAssignment[]
  tickets            Ticket[]
  scannerSessions    ScannerSession[]
  offlineBundles     OfflineValidationBundle[]
  offlineCheckIns    OfflineCheckIn[]
  analyticsEvents    AnalyticsEvent[]
  waitlistEntries    WaitlistEntry[]
  ticketBatches      TicketBatch[]
  reminderJobs       EventReminderJob[]

  @@unique([organizationId, slug])
  @@index([slug])
  @@index([status])
  @@index([startsAt])
  @@index([organizationId, status])
  @@index([sellerOrganizationId])
  @@index([visibility, status, startsAt])
  @@index([seriesId])
}

/// Shared defaults for recurring / related events (Friday Night series, etc.)
model EventSeries {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?  @db.Text
  venueId        String?
  coverImageUrl  String?
  ageLimit       Int?
  defaults       Json? // ticket type / tax / fee defaults snapshot
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
}

model EventImage {
  id        String   @id @default(cuid())
  eventId   String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ─── Ticket types & pricing tiers ────────────────────────────────────────────

model TicketType {
  id               String    @id @default(cuid())
  eventId          String
  name             String
  description      String?
  price            Int // øre — base/ordinary price
  vatRate          Int       @default(2500) // DEPRECATED: use taxTreatmentId
  taxTreatmentId   String?
  serviceFee       Int?
  serviceFeeTaxTreatmentId String?
  /// Event allocation cap for this type (≤ event capacity across types)
  quantityTotal    Int
  /// Currently released for sale (≤ quantityTotal). Available = released - sold - reserved
  quantityReleased Int       @default(0)
  quantitySold     Int       @default(0)
  quantityReserved Int       @default(0)
  maxPerOrder      Int       @default(10)
  minPerOrder      Int       @default(1)
  salesStartAt     DateTime?
  salesEndAt       DateTime?
  salesPausedAt    DateTime?
  isVisible        Boolean   @default(true)
  /// Free/guest types must set this false unless intentionally sold publicly at 0 kr
  isPubliclyPurchasable Boolean @default(true)
  /// MANUAL (default) or AUTOMATIC batch/price progression
  releaseMode      String    @default("MANUAL")
  /// Bundle: how many individual QR tickets to issue per purchased unit (4-pack → 4)
  admissionCount   Int       @default(1)
  isBundle         Boolean   @default(false)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  taxTreatment       TaxTreatment?       @relation("TicketTax", fields: [taxTreatmentId], references: [id], onDelete: SetNull)
  serviceFeeTaxTreatment TaxTreatment?   @relation("ServiceFeeTax", fields: [serviceFeeTaxTreatmentId], references: [id], onDelete: SetNull)
  priceTiers         TicketPriceTier[]
  orderItems         OrderItem[]
  reservations       TicketReservation[]
  tickets            Ticket[]
  promoCodes         PromoCode[]
  guestList          GuestListEntry[]
  priceHistory       PriceHistory[]
  batches            TicketBatch[]
  waitlistEntries    WaitlistEntry[]

  @@index([eventId, sortOrder])
  @@index([eventId, isVisible])
  @@index([taxTreatmentId])
}

/// Auditable price changes — never rewrite past orders/reservations
model PriceHistory {
  id           String   @id @default(cuid())
  ticketTypeId String
  oldPrice     Int
  newPrice     Int
  changedById  String?
  reason       String?
  ruleId       String? // optional automatic rule reference
  changedAt    DateTime @default(now())

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([ticketTypeId, changedAt])
}

/// Optional sales batches / drops (organizer-defined; not always shown to customer)
model TicketBatch {
  id           String    @id @default(cuid())
  eventId      String
  ticketTypeId String
  name         String?
  quantity     Int
  price        Int // øre at batch open
  sortOrder    Int       @default(0)
  releasedAt   DateTime?
  closedAt     DateTime?
  autoOpen     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@index([ticketTypeId])
}

enum WaitlistStatus {
  WAITING
  INVITED
  CLAIMED
  EXPIRED
  REMOVED
}

model WaitlistEntry {
  id                String         @id @default(cuid())
  eventId           String
  ticketTypeId      String?
  email             String
  name              String?
  phone             String?
  requestedQuantity Int            @default(1)
  /// @deprecated use requestedQuantity
  quantity          Int            @default(1)
  status            WaitlistStatus @default(WAITING)
  inviteToken       String?        @unique
  inviteExpiresAt   DateTime?
  claimedAt         DateTime?
  notifiedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)

  @@index([eventId, status, createdAt])
  @@index([eventId, email])
  @@index([ticketTypeId, status])
  @@index([inviteToken])
}

enum ReminderKind {
  EVENT_24H
  EVENT_3H
  EVENT_CHANGED
  EVENT_CANCELLED
}

enum ReminderJobStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

model EventReminderJob {
  id           String            @id @default(cuid())
  eventId      String
  orderId      String
  kind         ReminderKind
  scheduledFor DateTime
  status       ReminderJobStatus @default(SCHEDULED)
  sentAt       DateTime?
  error        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, orderId, kind])
  @@index([status, scheduledFor])
  @@index([eventId, kind])
}

/// Lightweight funnel / traffic analytics (not financial SoT)
model AnalyticsEvent {
  id           String             @id @default(cuid())
  eventId      String?
  organizationId String?
  type         AnalyticsEventType
  sessionId    String?
  orderId      String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  referrer     String?
  path         String?
  meta         Json?
  createdAt    DateTime           @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, type, createdAt])
  @@index([organizationId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

/// Early-bird / tiered pricing: first N tickets at price X, next M at Y, etc.
model TicketPriceTier {
  id           String   @id @default(cuid())
  ticketTypeId String
  name         String?
  price        Int // øre
  quantityFrom Int // inclusive sold count start (0-based)
  quantityTo   Int // inclusive sold count end
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([ticketTypeId, sortOrder])
}

// ─── Reservations (hold inventory during checkout) ───────────────────────────

model TicketReservation {
  id           String            @id @default(cuid())
  eventId      String
  ticketTypeId String
  quantity     Int
  sessionId    String
  status       ReservationStatus @default(ACTIVE)
  expiresAt    DateTime
  orderId      String?
  /// Locked unit price (øre) at reservation time — admin price changes do not affect this
  unitPriceSnapshot Int?
  serviceFeeSnapshot Int?
  lineTotalSnapshot  Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@index([expiresAt, status])
  @@index([ticketTypeId, status])
  @@index([orderId])
}

// ─── Orders & payments ───────────────────────────────────────────────────────

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique
  organizationId       String
  sellerOrganizationId String?
  eventId              String
  customerId           String?
  customerEmail        String
  customerPhone        String?
  customerFirstName    String
  customerLastName     String
  subtotal             Int // øre — gross ticket amount before platform fee split reporting
  serviceFee           Int           @default(0) // platform fee charged to customer (reporting)
  tax                  Int           @default(0)
  discount             Int           @default(0)
  total                Int
  // Settlement reporting fields (NOT stored customer funds / wallets)
  organizerAmount      Int           @default(0)
  platformFeeAmount    Int           @default(0)
  paymentProcessingFee Int           @default(0)
  currency             String        @default("NOK")
  paymentStatus        PaymentStatus @default(PENDING)
  orderStatus          OrderStatus   @default(PENDING)
  promoCodeId          String?
  reservationSessionId String?
  termsVersion         String?
  termsAcceptedAt      DateTime?
  privacyVersion       String?
  refundPolicyVersion  String?
  refundPolicyType     RefundPolicyType?
  marketingOptIn       Boolean       @default(false) // NEVER auto-set from purchase alone
  /// Unguessable token required to view QR / PDF for guest checkout
  accessToken          String        @unique @default(cuid())
  paymentAnomaly       Boolean       @default(false)
  paymentAnomalyReason String?
  paidAt               DateTime?
  cancelledAt          DateTime?
  /// Privacy-conscious traffic attribution (optional; from landing/checkout)
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  customer     User?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promoCode    PromoCode?          @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  tickets      Ticket[]
  payments     Payment[]
  refunds      Refund[]
  reservations TicketReservation[]
  snapshot     OrderSnapshot?

  @@index([orderNumber])
  @@index([accessToken])
  @@index([customerEmail])
  @@index([customerId])
  @@index([eventId, paymentStatus])
  @@index([organizationId, createdAt])
  @@index([paymentStatus, orderStatus])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Int // øre at time of purchase
  serviceFee   Int    @default(0)
  tax          Int    @default(0)
  total        Int
  name         String // snapshot of ticket type name

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

model Payment {
  id                    String              @id @default(cuid())
  orderId               String
  provider              PaymentProviderType
  providerPaymentId     String?
  providerSessionId     String?
  /// Nexi charge id required for refunds after capture
  providerChargeId      String?
  /// Normalized method from provider (VIPPS, VISA, MASTERCARD, APPLEPAY, …)
  paymentMethod         String?
  /// CARD | WALLET | INVOICE | OTHER
  paymentType           String?
  /// Raw provider status string (not Ticketly domain state)
  providerStatus        String?
  amount                Int
  currency              String              @default("NOK")
  status                PaymentStatus       @default(PENDING)
  providerMetadata      Json?
  rawPayload            Json?
  idempotencyKey        String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([providerSessionId])
  @@index([providerChargeId])
  @@index([status])
}

model Refund {
  id                String       @id @default(cuid())
  orderId           String
  paymentId         String?
  amount            Int
  currency          String       @default("NOK")
  status            RefundStatus @default(PENDING)
  reason            String?
  providerRefundId  String?
  ticketIds         String[] // tickets included in this refund
  processedById     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
}

enum WebhookProcessStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
  DUPLICATE
}

model WebhookEvent {
  id          String               @id @default(cuid())
  provider    PaymentProviderType
  eventId     String // external event id for idempotency
  eventType   String
  paymentId   String? // provider payment id when present
  orderId     String?
  payload     Json
  status      WebhookProcessStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime             @default(now())
  processedAt DateTime?
  createdAt   DateTime             @default(now())

  @@unique([provider, eventId])
  @@index([eventType])
  @@index([paymentId])
  @@index([status])
  @@index([receivedAt])
  @@index([createdAt])
}

// ─── Tickets ─────────────────────────────────────────────────────────────────

model Ticket {
  id              String       @id @default(cuid())
  publicId        String       @unique // human-readable e.g. TKT-A1B2C3
  /// SHA-256 hex of QR token — used for lookup; raw token not required for validation
  tokenHash       String       @unique
  /// Encrypted raw token for re-display (AES); never use for validation alone
  tokenCipher     String?
  /// DEPRECATED plaintext — kept nullable during migration; prefer tokenHash/tokenCipher
  secureToken     String?      @unique
  orderId         String
  orderItemId     String
  eventId         String
  ticketTypeId    String
  holderName      String?
  holderEmail     String?
  status          TicketStatus @default(VALID)
  checkedInAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem  OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType        @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  checkIns   CheckIn[]
  transfers  TicketTransfer[]

  @@index([tokenHash])
  @@index([secureToken])
  @@index([publicId])
  @@index([orderId])
  @@index([eventId, status])
  @@index([holderEmail])
  @@index([ticketTypeId])
}

/// Revocable mobile API sessions (HMAC token jti)
model MobileSession {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TicketTransfer {
  id            String   @id @default(cuid())
  ticketId      String
  fromUserId    String?
  toUserId      String?
  fromEmail     String
  toEmail       String
  toName        String
  oldToken      String
  newToken      String
  transferredAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUser User?  @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser   User?  @relation("TransferTo", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([toEmail])
}

// ─── Check-in ────────────────────────────────────────────────────────────────

model CheckIn {
  id          String        @id @default(cuid())
  ticketId    String?
  eventId     String
  checkedInAt DateTime      @default(now())
  checkedInBy String?
  deviceId    String?
  result      CheckInResult
  note        String?
  isManual    Boolean       @default(false)

  ticket  Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff   User?   @relation(fields: [checkedInBy], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([eventId, checkedInAt])
  @@index([checkedInBy])
  @@index([result])
}

// ─── Guest list ──────────────────────────────────────────────────────────────

model GuestListEntry {
  id           String    @id @default(cuid())
  eventId      String
  ticketTypeId String?
  name         String
  email        String?
  phone        String?
  comment      String?
  partySize    Int       @default(1)
  createdById  String?
  checkedInAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("GuestListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([email])
  @@index([phone])
  @@index([name])
}

// ─── Promo codes ─────────────────────────────────────────────────────────────

model PromoCode {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String?
  ticketTypeId   String?
  code           String
  discountType   DiscountType
  discountValue  Int // percentage basis points (2000=20%) or fixed øre
  maxUses        Int?
  usedCount      Int          @default(0)
  startAt        DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType?  @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([organizationId, code])
  @@index([code])
  @@index([eventId])
  @@index([isActive])
}

// ─── Audit & system ──────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([organizationId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   Json?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level, createdAt])
  @@index([createdAt])
}

model OrderSequence {
  id      String @id // e.g. "2026"
  counter Int    @default(0)
}

// ─── Immutable purchase snapshot (receipt / legal record) ────────────────────

/// Frozen seller, pricing, tax and terms at purchase time. Never rewrite on org rename.
model OrderSnapshot {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  payload              Json // full immutable snapshot
  sellerLegalName      String
  sellerOrgNumber      String?
  sellerAddress        String?
  termsVersion         String
  refundPolicyType     RefundPolicyType
  eventName            String
  eventStartsAt        DateTime
  currency             String
  createdAt            DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── Tax configuration (admin/accounting — not inferred from event name) ─────

model TaxCode {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. NO_VAT_STANDARD, NO_VAT_EXEMPT_CULTURE
  name        String
  description String?
  country     String   @default("NO")
  createdAt   DateTime @default(now())

  rates      TaxRate[]
  treatments TaxTreatment[]
}

model TaxRate {
  id        String    @id @default(cuid())
  taxCodeId String
  rateBps   Int // basis points, 2500 = 25%
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime  @default(now())

  taxCode TaxCode @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)

  @@index([taxCodeId, validFrom])
}

model TaxTreatment {
  id             String   @id @default(cuid())
  organizationId String?
  taxCodeId      String
  name           String
  description    String?
  isPlatformFee  Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode           TaxCode       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  ticketTypes       TicketType[]  @relation("TicketTax")
  serviceFeeTickets TicketType[]  @relation("ServiceFeeTax")

  @@index([organizationId])
  @@index([taxCodeId])
}

// ─── GDPR / privacy ──────────────────────────────────────────────────────────

model ConsentRecord {
  id          String         @id @default(cuid())
  userId      String?
  email       String? // guest checkout
  purpose     ConsentPurpose
  version     String
  grantedAt   DateTime?
  withdrawnAt DateTime?
  source      String // checkout | settings | import | admin
  ipAddress   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, purpose])
  @@index([email, purpose])
  @@index([purpose, grantedAt])
}

model DataSubjectRequest {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  type        String // ACCESS | EXPORT | RECTIFY | ERASE | WITHDRAW_CONSENT
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED
  note        String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
}

model RetentionPolicy {
  id             String   @id @default(cuid())
  organizationId String?
  dataCategory   String // SCANNER_LOGS | DEVICE_META | ANALYTICS | ORDERS | AUDIT | PII_MARKETING
  retainDays     Int
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dataCategory])
}

model PlatformTerms {
  id        String   @id @default(cuid())
  version   String   @unique
  title     String
  body      String   @db.Text
  publishedAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

// ─── Push notifications ──────────────────────────────────────────────────────

model PushToken {
  id        String         @id @default(cuid())
  userId    String?
  token     String         @unique
  platform  DevicePlatform
  provider  String         @default("EXPO") // EXPO | APNS | FCM
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id         String                @id @default(cuid())
  userId     String
  channel    NotificationChannel
  category   NotificationCategory
  enabled    Boolean               @default(true)
  updatedAt  DateTime              @updatedAt
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model NotificationLog {
  id         String                     @id @default(cuid())
  userId     String?
  orderId    String?
  eventId    String?
  channel    NotificationChannel
  category   NotificationCategory
  title      String
  body       String
  payload    Json?
  status     NotificationDeliveryStatus @default(SENT)
  sentAt     DateTime                   @default(now())
  provider   String?
  externalId String?
  error      String?

  @@index([userId, sentAt])
  @@index([orderId, sentAt])
  @@index([eventId, sentAt])
  @@index([category, sentAt])
  @@index([status, sentAt])
}

// ─── Devices & scanner sessions ──────────────────────────────────────────────

model Device {
  id             String         @id @default(cuid())
  organizationId String
  deviceName     String
  platform       DevicePlatform
  appVersion     String?
  pushToken      String?
  lastSeenAt     DateTime?
  activatedAt    DateTime       @default(now())
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scannerSessions ScannerSession[]
  offlineCheckIns OfflineCheckIn[]

  @@index([organizationId, revokedAt])
  @@index([lastSeenAt])
}

model ScannerSession {
  id         String    @id @default(cuid())
  deviceId   String
  eventId    String
  userId     String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  isActive   Boolean   @default(true)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId, isActive])
  @@index([eventId, isActive])
  @@index([userId])
}

/// Signed/encrypted validation dataset for offline door scanning (minimal PII).
model OfflineValidationBundle {
  id              String   @id @default(cuid())
  organizationId  String
  eventId         String
  version         Int
  /// Encrypted blob: ticket publicId + HMAC/token hash + status — NO names/emails/phones
  encryptedPayload String  @db.Text
  payloadChecksum String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, version])
  @@index([eventId, expiresAt])
}

model OfflineCheckIn {
  id              String           @id @default(cuid())
  localId         String           @unique // client-generated UUID
  sequenceNumber  Int
  eventId         String
  ticketPublicId  String // NOT sequential DB id
  ticketTokenHash String // hash of secure token — not the raw token long-term if possible
  deviceId        String?
  staffUserId     String?
  localCheckedInAt DateTime
  result          CheckInResult
  syncStatus      OfflineSyncStatus @default(PENDING)
  syncedCheckInId String?
  conflictReason  String?
  createdAt       DateTime         @default(now())
  syncedAt        DateTime?

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  staff  User?   @relation("OfflineCheckInStaff", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([eventId, syncStatus])
  @@index([ticketPublicId])
  @@index([deviceId])
}

/// Wallet pass issuance tracking — Apple/Google require certs; no fake passes.
model WalletPass {
  id           String   @id @default(cuid())
  ticketId     String
  provider     String // APPLE | GOOGLE
  externalId   String?
  status       String   @default("PENDING") // PENDING | ISSUED | FAILED | REVOKED
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ticketId, provider])
  @@index([status])
}
