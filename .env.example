# Database
DATABASE_URL="postgresql://ticketly:ticketly@localhost:5432/ticketly?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3456"
APP_URL="http://localhost:3456"
NODE_ENV="development"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"
# AUTH_URL is optional in Auth.js v5; APP_URL is used as fallback

# Stripe (use test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Optional: Stripe mock mode for local demo without real Stripe
# When true, checkout creates a mock payment session that can be completed via /api/payments/mock/complete
STRIPE_MOCK_MODE="true"

# Email (console provider by default in development)
EMAIL_PROVIDER="console"
# RESEND_API_KEY=
# EMAIL_FROM="billett@example.com"

# Reservation hold duration (minutes)
RESERVATION_TTL_MINUTES="10"

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="60"

# Ticket QR base URL (defaults to APP_URL)
# TICKET_VERIFY_BASE_URL="https://domain.no"
