# Stitch (Google) — required to fetch design screens for Obsidian Signal UX sync
# STITCH_API_KEY=
# STITCH_ACCESS_TOKEN=
# GOOGLE_CLOUD_PROJECT=

# Database
DATABASE_URL="postgresql://ticketly:ticketly@localhost:5432/ticketly?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3456"
APP_URL="http://localhost:3456"
NODE_ENV="development"

# Seed — required for npm run db:seed (development|demo). Leave unset / none in production.
# SEED_MODE="development"

# Dev-only login prefill (ignored when NODE_ENV=production)
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="true"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"
# Optional Auth.js base URL (set to APP_URL on Vercel Preview if callbacks fail)
# AUTH_URL=

# Ticket QR token encryption-at-rest (falls back to AUTH_SECRET)
TICKET_TOKEN_SECRET="generate-a-long-random-secret-at-least-32-chars"

# Dynamic QR — KEEP false in production until lifecycle is fully tested.
# Even with Event.qrMode=DYNAMIC_QR, minting/verification stays off unless this is true.
# ENABLE_DYNAMIC_QR="false"
# DYNAMIC_QR_CLOCK_SKEW_SECONDS="30"

# Offline scanner bundle encryption
OFFLINE_BUNDLE_SECRET="generate-another-long-random-secret"

# Protect /api/cron/reminders (required when cron is enabled)
# CRON_SECRET=

# Terms version stamped on checkout (default 2026-01)
# TERMS_VERSION="2026-10"

# Enforce env schema outside production (local / Preview debugging)
# FORCE_ENV_VALIDATE="true"

# Minutes after reservation expiry to still hold inventory for in-flight payment
PAYMENT_GRACE_MINUTES="15"

# Upstash Redis (Vercel Marketplace) — NOT Vercel KV
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — event cover uploads (server-only; never expose to browser)
# Create a Blob store in the Vercel project and copy the read-write token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Payments (production CURRENT: Stripe Checkout Form; Nexi = future/optional) ─
# nexi | stripe | mock
# Production CURRENT PSP: stripe (live keys). Never default to mock.
# Production APP_URL / NEXT_PUBLIC_APP_URL: https://billett.xodrammen.no
# Vercel Preview E2E: PAYMENT_PROVIDER=stripe + Stripe TEST keys; leave Nexi unset.
PAYMENT_PROVIDER="stripe"

# Stripe — CURRENT production provider (required when PAYMENT_PROVIDER=stripe)
# Live: sk_live_… / pk_live_… ; Preview/local: sk_test_… / pk_test_…
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# NEVER true in production. Forbidden when NODE_ENV=production.
STRIPE_MOCK_MODE="false"
# Silences sk_test_ warning on Vercel Preview (NODE_ENV=production)
# ALLOW_STRIPE_TEST_IN_PROD="true"

# Nexi Checkout / Nets Easy — FUTURE / OPTIONAL (not current production PSP)
# test → https://test.api.dibspayment.eu
# production → https://api.dibspayment.eu
# NEXI_ENVIRONMENT="test"
# NEXI_SECRET_API_KEY="test-secret-key-from-portal"
# NEXI_CHECKOUT_KEY="test-checkout-key-from-portal"
# Optional alias for client bundles (same value as NEXI_CHECKOUT_KEY; never put secret key here)
# NEXT_PUBLIC_NEXI_CHECKOUT_KEY=
# Optional merchant number when required by your Nexi agreement
# NEXI_MERCHANT_ID=
# Shared secret (8–64 chars) sent as Authorization on webhooks you subscribe at payment create
# NEXI_WEBHOOK_SECRET="change-me-8to64-chars-alphanum"
# ALLOW_NEXI_TEST_IN_PROD="true"

# Local-only mock PSP (explicit). Forbidden as production default.
# PAYMENT_PROVIDER="mock"

# Email — production must NOT use console (launch BLOCKED until real provider)
# console | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@ticketly.local"
# Required when EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# Push (EXPO | APNS | FCM)
PUSH_PROVIDER="EXPO"

# Mobile API base (Expo) — points at apps/web, not apps/api
EXPO_PUBLIC_API_URL="http://localhost:3456"

# SUPER_ADMIN event test-data reset — emergency override only. Default path
# requires all financial orders fully refunded. Never enable casually in prod.
# ALLOW_PRODUCTION_EVENT_RESET="true"

# Reservation
RESERVATION_TTL_MINUTES="10"

# Apple Wallet (optional — leave unset to keep Add to Wallet hidden)
# APPLE_WALLET_PASS_TYPE_ID=
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_CERT_PATH=

# Google Wallet (optional)
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
